{
  "name": "php-weather/core",
  "type": "library",
  "description": "Weather development library",
  "homepage": "https://github.com/php-weather",
  "license": "MIT",
  "authors": [
    {
      "name": "Dominik Schwind",
      "email": "dschwind@lostfocus.de",
      "homepage": "https://lostfocus.de",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8",
    "ext-json": "*"
  },
  "require-dev": {
    "php-http/guzzle7-adapter": "*",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9.0"
  },
  "autoload": {
    "psr-4": {
      "PhpWeather\\": "Src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PhpWeather\\": "Tests"
    }
  },
  "scripts": {
    "test": "phpunit",
    "phpstan": "phpstan analyse Src Tests --level=9"
  },
  "config": {
    "lock": false,
    "sort-packages": true
  }
}